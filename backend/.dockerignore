# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment files (secrets should not be in image)
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker files (not needed inside container)
Dockerfile
.dockerignore
docker-compose*.yml

# Tests (optional - include if you want to run tests in container)
# tests/
# pytest.ini
# .pytest_cache/

# Database files
*.db
*.sqlite3

# Logs
*.log
