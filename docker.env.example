# ==========================================
# VITA-CARE Docker Environment Configuration
# ==========================================
# Copy this file to .env before running docker-compose
# cp docker.env.example .env

# ------------------------------
# Gemini API Configuration
# ------------------------------
# Get your API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------
# Supabase Configuration
# ------------------------------
# Your Supabase Project URL and API Key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ------------------------------
# JWT Configuration
# ------------------------------
# Secret key for signing JWT tokens. Change this to a secure random string!
JWT_SECRET=change_this_to_a_secure_random_string
# Algorithm used for signing (default: HS256)
JWT_ALGORITHM=HS256
# Token expiration time in hours (default: 24)
JWT_EXPIRATION_HOURS=24
